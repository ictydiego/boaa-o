rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId);
    }

    match /donations/{donationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.donorId == request.auth.uid;
      allow update: if isSignedIn();
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ngoId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ngoId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ngoId == request.auth.uid;

      match /attendances/{attendanceId} {
        allow read: if isSignedIn();

        // Volunteer subscribes himself
        allow create: if isSignedIn()
          && request.resource.data.volunteerId == request.auth.uid
          && request.resource.data.status == 'SUBSCRIBED';

        // Updates allowed for the ONG (check-in/out) or volunteer (read-only states)
        allow update: if isSignedIn() && (
          get(/databases/$(database)/documents/events/$(eventId)).data.ngoId == request.auth.uid
          || resource.data.volunteerId == request.auth.uid
        );
      }
    }

    match /pointsTransactions/{txId} {
      allow read, write: if isSignedIn();
    }

    match /giftCards/{cardId} {
      allow read, write: if isSignedIn();
    }
  }
}
